LITELLM_MASTER_KEY=
LITELLM_BASE_URL=

AUTH_USERNAME=
# bcrypt hash of the password, not the plaintext — generate with:
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH=

# Local dev: docker compose -f local_dev/docker-compose.yml up -d
MONGODB_URI=mongodb://root:secret@localhost:27019/?directConnection=true
MONGODB_DB_NAME=cortex

# Deployed frontend origin (e.g. https://your-app.vercel.app), for CORS.
# Not needed locally — the dev server's localhost/127.0.0.1 origin is always allowed.
FRONTEND_ORIGIN=