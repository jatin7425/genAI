LITELLM_MASTER_KEY=
LITELLM_BASE_URL=

AUTH_USERNAME=
# bcrypt hash of the password, not the plaintext — generate with:
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH=

# local  -> JSON-file storage under src/data/ (no DB needed, current default)
# deployed -> MongoDB storage, requires MONGODB_URI below
ENV=local
MONGODB_URI=
MONGODB_DB_NAME=cortex